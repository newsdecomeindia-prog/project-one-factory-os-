  receiverId         String   @map("receiver_id")
  companyId          String   @map("company_id")
  plantId            String   @map("plant_id")
  status             String   @default("COMPLETED") @map("status")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String?  @map("created_by")

  workOrder         WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  execution         ProductionExecution @relation(fields: [executionId], references: [id], onDelete: Restrict)
