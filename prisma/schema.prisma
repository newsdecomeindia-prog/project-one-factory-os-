  binId             String?  @map("bin_id")
  companyId         String   @map("company_id")
  plantId           String   @map("plant_id")
  status            String   @default("RESERVED") @map("status")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdBy         String?  @map("created_by")

  workOrder      WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  bomHeader      BomHeader       @relation(fields: [bomHeaderId], references: [id], onDelete: Restrict)
  material       Material        @relation("ReservedMaterial", fields: [materialId], references: [id], onDelete: Restrict)
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  bin            StorageBin?     @relation(fields: [binId], references: [id], onDelete: SetNull)
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plant          Plant           @relation(fields: [plantId], references: [id], onDelete: Restrict)
  materialIssues MaterialIssue[]

  @@map("material_reservations")
}

model MaterialIssue {
  id             String   @id @default(uuid())
  issueNumber    String   @unique @map("issue_number")
  workOrderId    String   @map("work_order_id")
  reservationId  String?  @map("reservation_id")
  materialId     String   @map("material_id")
  issuedQuantity Float    @map("issued_quantity")
  uomId          String   @map("uom_id")
  warehouseId    String   @map("warehouse_id")
  binId          String?  @map("bin_id")
  issuerId       String   @map("issuer_id")
  companyId      String   @map("company_id")
  plantId        String   @map("plant_id")
  status         String   @default("COMPLETED") @map("status")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String?  @map("created_by")

  workOrder         WorkOrder            @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  reservation       MaterialReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  material          Material             @relation("IssuedMaterial", fields: [materialId], references: [id], onDelete: Restrict)
  uom               Uom                  @relation(fields: [uomId], references: [id], onDelete: Restrict)
  warehouse         Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  bin               StorageBin?          @relation(fields: [binId], references: [id], onDelete: SetNull)
  issuer            User                 @relation("MaterialIssuer", fields: [issuerId], references: [id], onDelete: Restrict)
  company           Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plant             Plant                @relation(fields: [plantId], references: [id], onDelete: Restrict)
  stockTransactions StockTransaction[]

  @@map("material_issues")
}

model ProductionExecution {
  id                 String   @id @default(uuid())
  executionNumber    String   @unique @map("execution_number")
  workOrderId        String   @map("work_order_id")
  finishedMaterialId String   @map("finished_material_id")
  plannedQuantity    Float    @map("planned_quantity")
  executedQuantity   Float    @map("executed_quantity")
  goodQuantity       Float    @map("good_quantity")
  rejectedQuantity   Float    @default(0) @map("rejected_quantity")
  holdQuantity       Float    @default(0) @map("hold_quantity")
  operatorId         String   @map("operator_id")
  productionLine     String?  @map("production_line")
  startTime          DateTime @map("start_time")
  endTime            DateTime @map("end_time")
  status             String   @default("COMPLETED") @map("status")
  remarks            String?
