  workOrderId      String?  @map("work_order_id")
  executionId      String?  @map("execution_id")
  materialId       String   @map("material_id")
  uomId            String   @map("uom_id")
  inspectedQuantity Float   @map("inspected_quantity")
  passedQuantity   Float    @map("passed_quantity")
  failedQuantity   Float    @default(0) @map("failed_quantity")
  inspectorId      String   @map("inspector_id")
  remarks          String?
  companyId        String   @map("company_id")
  plantId          String   @map("plant_id")
  departmentId     String?  @map("department_id")
  status           String   @default("PASSED") @map("status")
  inspectionDate   DateTime @default(now()) @map("inspection_date")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by")

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plant                 Plant                  @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department            Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  workOrder             WorkOrder?             @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  execution             ProductionExecution?   @relation(fields: [executionId], references: [id], onDelete: SetNull)
  material              Material               @relation(fields: [materialId], references: [id], onDelete: Restrict)
  uom                   Uom                    @relation(fields: [uomId], references: [id], onDelete: Restrict)
