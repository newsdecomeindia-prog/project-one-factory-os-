model NonConformanceReport {
  id                String    @id @default(uuid())
  ncrNumber         String    @unique @map("ncr_number")
  sourceType        String    @default("IPQC") @map("source_type")
  sourceRecordId    String?   @map("source_record_id")
  ipqcId            String?   @map("ipqc_id")
  workOrderId       String?   @map("work_order_id")
  materialId        String    @map("material_id")
  uomId             String?   @map("uom_id")
  defectType        String    @map("defect_type")
  defectQuantity    Float     @map("defect_quantity")
  disposition       String    @default("PENDING") @map("disposition")
  dispositionReason String?   @map("disposition_reason")
  reworkWoNumber    String?   @map("rework_wo_number")
  assignedToId      String?   @map("assigned_to_id")
  approvedById      String?   @map("approved_by_id")
  approvedAt        DateTime? @map("approved_at")
  companyId         String    @map("company_id")
  plantId           String    @map("plant_id")
  departmentId      String?   @map("department_id")
  status            String    @default("OPEN") @map("status")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  createdBy         String?   @map("created_by")

  company    Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plant      Plant                  @relation(fields: [plantId], references: [id], onDelete: Restrict)
  department Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  ipqc       InProcessQaInspection? @relation(fields: [ipqcId], references: [id], onDelete: SetNull)
  workOrder  WorkOrder?             @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  material   Material               @relation(fields: [materialId], references: [id], onDelete: Restrict)
  uom        Uom?                   @relation(fields: [uomId], references: [id], onDelete: SetNull)
  assignedTo User?                  @relation("NcrAssignedUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  approver   User?                  @relation("NcrApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("non_conformance_reports")
}

model InventoryTransferOrder {
  id                String    @id @default(uuid())
  transferNumber    String    @unique @map("transfer_number")
